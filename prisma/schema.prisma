// Prisma schema — Nadzir Story Web Studio
// Database: SQLite (file db/custom.db)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  title     String   @default("Proyek Tanpa Judul")
  genre     String   @default("Drama")
  style     String   @default("cinematic")
  premise   String   @default("")
  logline   String   @default("")
  story     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  characters Character[]
  scenes     Scene[]
}

model Character {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String   @default("")
  imageUrl    String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Scene {
  id            String   @id @default(cuid())
  projectId     String
  order         Int      @default(0)
  title         String   @default("")
  narration     String   @default("")
  imagePrompt   String   @default("")
  videoPrompt   String   @default("")
  imageUrl      String?
  videoUrl      String?
  videoTaskId   String?
  videoProvider String?  // null = Nadzir AI bawaan; "gemini" = operasi Veo Gemini
  status        String   @default("draft")
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// Penyimpanan key-value sederhana (mis. kunci API penyedia yang dipakai user).
model Setting {
  key   String @id
  value String
}
